#!/bin/bash
#
# pre-push hook
# Automatically saves session state before pushing
#
# This ensures that whenever work is pushed, the session state is preserved
# for the next session to pick up seamlessly.
#

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'
DIM='\033[2m'

# Check if this is a phase worktree
if [ -d ".phase-status" ]; then
    echo ""
    echo -e "${CYAN}══════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}         AUTOMATIC SESSION STATE SAVE (pre-push)              ${NC}"
    echo -e "${CYAN}══════════════════════════════════════════════════════════════${NC}"
    echo ""

    # Find the session-save script
    SCRIPT_LOCATIONS=(
        "./scripts/session-save.sh"
        "../scripts/session-save.sh"
        "../../scripts/session-save.sh"
    )

    SAVE_SCRIPT=""
    for loc in "${SCRIPT_LOCATIONS[@]}"; do
        if [ -x "$loc" ]; then
            SAVE_SCRIPT="$loc"
            break
        fi
    done

    if [ -n "$SAVE_SCRIPT" ]; then
        echo -e "${GREEN}Auto-saving session state before push...${NC}"
        "$SAVE_SCRIPT" --auto "$(pwd)"
    else
        echo -e "${DIM}session-save.sh not found, skipping auto-save${NC}"
    fi

    echo ""
    echo -e "${DIM}(Auto-triggered by pre-push hook)${NC}"
    echo ""
fi

# Always allow the push to proceed
exit 0
