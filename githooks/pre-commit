#!/bin/bash
#
# pre-commit hook for Agentic Development Process
# Enforces quality gates before any commit is allowed
#
# Installation:
#   cp githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or configure git to use this directory:
#   git config core.hooksPath githooks
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

# Configuration (override in .pre-commit-config if needed)
RUN_TESTS="${PRE_COMMIT_RUN_TESTS:-true}"
RUN_LINT="${PRE_COMMIT_RUN_LINT:-true}"
RUN_BUILD="${PRE_COMMIT_RUN_BUILD:-true}"
CHECK_SECRETS="${PRE_COMMIT_CHECK_SECRETS:-true}"
REQUIRE_TEST_PASS="${PRE_COMMIT_REQUIRE_TEST_PASS:-true}"

# Load local config if exists
if [ -f ".pre-commit-config" ]; then
    source .pre-commit-config
fi

echo ""
echo -e "${BOLD}${CYAN}══════════════════════════════════════════════════════════════${NC}"
echo -e "${BOLD}${CYAN}              PRE-COMMIT QUALITY GATE CHECK                    ${NC}"
echo -e "${BOLD}${CYAN}══════════════════════════════════════════════════════════════${NC}"
echo ""

FAILED=0

# Helper function
check_result() {
    local name="$1"
    local result="$2"

    if [ "$result" -eq 0 ]; then
        echo -e "  ${GREEN}✓${NC} $name"
    else
        echo -e "  ${RED}✗${NC} $name"
        FAILED=1
    fi
}

# 1. Check for secrets/sensitive data
if [ "$CHECK_SECRETS" = "true" ]; then
    echo -e "${CYAN}Checking for secrets...${NC}"

    # Patterns that might indicate secrets
    SECRET_PATTERNS=(
        'password\s*=\s*["\x27][^"\x27]+'
        'api[_-]?key\s*=\s*["\x27][^"\x27]+'
        'secret\s*=\s*["\x27][^"\x27]+'
        'token\s*=\s*["\x27][^"\x27]+'
        'AWS_ACCESS_KEY_ID'
        'AWS_SECRET_ACCESS_KEY'
        'PRIVATE[_-]KEY'
        '-----BEGIN.*PRIVATE KEY-----'
        'sk-[a-zA-Z0-9]{20,}'
        'ghp_[a-zA-Z0-9]{36}'
    )

    SECRET_FOUND=0

    # Check staged files only
    for pattern in "${SECRET_PATTERNS[@]}"; do
        if git diff --cached --name-only | xargs grep -l -E "$pattern" 2>/dev/null | grep -v -E '\.(md|example|sample)$' > /dev/null; then
            SECRET_FOUND=1
            echo -e "  ${RED}Potential secret found matching: $pattern${NC}"
        fi
    done

    # Check for .env files being committed
    if git diff --cached --name-only | grep -E '^\.env$|^\.env\.' | grep -v '.example' > /dev/null 2>&1; then
        SECRET_FOUND=1
        echo -e "  ${RED}.env file detected in commit!${NC}"
    fi

    check_result "Secret scan" $SECRET_FOUND
fi

# 2. Run linter (if available)
if [ "$RUN_LINT" = "true" ]; then
    echo -e "${CYAN}Running linter...${NC}"

    LINT_RESULT=0

    if [ -f "package.json" ]; then
        if grep -q '"lint"' package.json; then
            npm run lint --silent 2>/dev/null || LINT_RESULT=$?
        elif [ -f ".eslintrc.js" ] || [ -f ".eslintrc.json" ] || [ -f ".eslintrc" ]; then
            npx eslint . --quiet 2>/dev/null || LINT_RESULT=$?
        else
            echo -e "  ${YELLOW}⚠${NC} No linter configured, skipping"
            LINT_RESULT=0
        fi
    elif [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
        if command -v ruff &> /dev/null; then
            ruff check . 2>/dev/null || LINT_RESULT=$?
        elif command -v flake8 &> /dev/null; then
            flake8 . 2>/dev/null || LINT_RESULT=$?
        else
            echo -e "  ${YELLOW}⚠${NC} No Python linter found, skipping"
            LINT_RESULT=0
        fi
    elif [ -f "go.mod" ]; then
        go vet ./... 2>/dev/null || LINT_RESULT=$?
    else
        echo -e "  ${YELLOW}⚠${NC} No recognized project type, skipping lint"
        LINT_RESULT=0
    fi

    check_result "Linting" $LINT_RESULT
fi

# 3. Run tests
if [ "$RUN_TESTS" = "true" ]; then
    echo -e "${CYAN}Running tests...${NC}"

    TEST_RESULT=0

    if [ -f "package.json" ]; then
        if grep -q '"test"' package.json; then
            # Check if test script is not just "echo" placeholder
            if ! grep -q '"test":\s*"echo' package.json; then
                npm test --silent 2>/dev/null || TEST_RESULT=$?
            else
                echo -e "  ${YELLOW}⚠${NC} Test script is placeholder, skipping"
            fi
        else
            echo -e "  ${YELLOW}⚠${NC} No test script in package.json"
        fi
    elif [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
        if command -v pytest &> /dev/null; then
            pytest --quiet 2>/dev/null || TEST_RESULT=$?
        else
            echo -e "  ${YELLOW}⚠${NC} pytest not found, skipping"
        fi
    elif [ -f "go.mod" ]; then
        go test ./... 2>/dev/null || TEST_RESULT=$?
    elif [ -f "Cargo.toml" ]; then
        cargo test --quiet 2>/dev/null || TEST_RESULT=$?
    else
        echo -e "  ${YELLOW}⚠${NC} No recognized test framework"
        TEST_RESULT=0
    fi

    if [ "$REQUIRE_TEST_PASS" = "true" ]; then
        check_result "Tests" $TEST_RESULT
    else
        if [ "$TEST_RESULT" -ne 0 ]; then
            echo -e "  ${YELLOW}⚠${NC} Tests failed (non-blocking)"
        else
            echo -e "  ${GREEN}✓${NC} Tests"
        fi
    fi
fi

# 4. Run build
if [ "$RUN_BUILD" = "true" ]; then
    echo -e "${CYAN}Running build...${NC}"

    BUILD_RESULT=0

    if [ -f "package.json" ]; then
        if grep -q '"build"' package.json; then
            npm run build --silent 2>/dev/null || BUILD_RESULT=$?
        elif [ -f "tsconfig.json" ]; then
            npx tsc --noEmit 2>/dev/null || BUILD_RESULT=$?
        else
            echo -e "  ${YELLOW}⚠${NC} No build script, skipping"
            BUILD_RESULT=0
        fi
    elif [ -f "go.mod" ]; then
        go build ./... 2>/dev/null || BUILD_RESULT=$?
    elif [ -f "Cargo.toml" ]; then
        cargo build --quiet 2>/dev/null || BUILD_RESULT=$?
    else
        echo -e "  ${YELLOW}⚠${NC} No recognized build system"
        BUILD_RESULT=0
    fi

    check_result "Build" $BUILD_RESULT
fi

# 5. Check for large files
echo -e "${CYAN}Checking file sizes...${NC}"
LARGE_FILES=$(git diff --cached --name-only | while read file; do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 1048576 ]; then  # 1MB
            echo "$file ($((size / 1024))KB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "  ${YELLOW}⚠${NC} Large files detected:"
    echo "$LARGE_FILES" | while read line; do
        echo -e "      $line"
    done
else
    echo -e "  ${GREEN}✓${NC} No large files"
fi

# 6. Verify commit message convention (if using conventional commits)
# This runs after the commit message is entered, so we skip here
# Use commit-msg hook instead

echo ""
echo -e "${CYAN}══════════════════════════════════════════════════════════════${NC}"

if [ "$FAILED" -eq 1 ]; then
    echo ""
    echo -e "${RED}${BOLD}COMMIT BLOCKED${NC}"
    echo -e "${RED}Quality gates failed. Please fix the issues above.${NC}"
    echo ""
    echo -e "${YELLOW}To bypass (NOT RECOMMENDED):${NC}"
    echo -e "  git commit --no-verify"
    echo ""
    exit 1
else
    echo ""
    echo -e "${GREEN}${BOLD}ALL QUALITY GATES PASSED${NC}"
    echo -e "${GREEN}Commit allowed.${NC}"
    echo ""
    exit 0
fi
